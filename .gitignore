# Machine-specific settings and credentials: never commit
.env
config/local.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Simulator output. New simulator runs write trajectories to data/traces/,
# which is not part of the release.
data/traces/
data/results/raw/
*.parquet

# Cache written by scripts/check_prompt_budget.py
data/results/.token_count_cache.json

# Raw API records written by new model calls. Only the 21 baseline-synthesis
# records are released (re-included below). Written as `dir/*`, not `dir/`,
# because git cannot re-include a file whose parent directory is excluded.
logs/llm_raw/*

# Logs and process files
*.log
*.pid

# CARLA install, if placed inside the repository
CARLA_*/
carla/
*.tar.gz

# LaTeX intermediates
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# OS and editors
.DS_Store
.idea/
.vscode/
*.swp

# Released files that the rules above would otherwise ignore. These negations
# override `*.parquet`, `*.log` and `logs/llm_raw/*`, so they must stay last.
!data/certificates/traces/*.parquet
!data/dsl_probe_traces/**
!data/calibration_traces/**
!logs/llm_raw/synth_*.json
!logs/e1_phase_a.log
!logs/e1_phase_b.log

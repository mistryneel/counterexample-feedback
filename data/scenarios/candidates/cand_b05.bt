# Unprotected left turn at a signalised four-way junction.
# Priority order: (1) never abandon a turn already underway,
# (2) deadlock escape, (3) lead-vehicle spacing, (4) gap acceptance,
# (5) lawful stop-and-wait, (6) normal approach.

Selector

  # ---- 1. Already inside the conflict zone: always finish the turn. ----
  #    No gating conditions here, so nothing can abort us mid-junction.
  Sequence
    InConflictZone
    CommitTurn(v_mps=6.0, accel_mps2=2.0)

  # ---- 2. Deadlock escape: stationary a long time, green, minimal gap. ----
  Sequence
    TrafficLightIsGreen
    WaitedLongerThan(t_s=14.0)
    DistanceToStopLineBelow(dist_m=6.0)
    OncomingGapExceeds(gap_s=4.0)
    PathIsClear(dist_m=10.0)
    CommitTurn(v_mps=5.0, accel_mps2=2.0)

  # ---- 3. Everything else is gated on keeping clear of the lead vehicle. ----
  Selector

    Sequence
      PathIsClear(dist_m=24.0)

      Selector

        # 4. Green, close to the line, generous oncoming gap, path clear: go.
        Sequence
          TrafficLightIsGreen
          DistanceToStopLineBelow(dist_m=18.0)
          OncomingGapExceeds(gap_s=6.0)
          PathIsClear(dist_m=14.0)
          CommitTurn(v_mps=6.0, accel_mps2=2.0)

        # 5. Yellow/red, or no acceptable gap: stop at the line and wait.
        Sequence
          DistanceToStopLineBelow(dist_m=20.0)
          HoldAtStopLine(decel_mps2=1.8)

        # 6. Normal approach from a distance.
        Cruise(v_mps=8.0, accel_mps2=1.5)

    # Lead vehicle inside our spacing envelope and we are near the line:
    # settle in behind it at the stop line.
    Sequence
      DistanceToStopLineBelow(dist_m=14.0)
      HoldAtStopLine(decel_mps2=2.0)

    # Lead vehicle inside our spacing envelope further back: ease off.
    Decelerate(v_mps=2.0, decel_mps2=2.0)
